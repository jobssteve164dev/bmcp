{
  "name": "solobrowser",
  "displayName": "SoloBrowser",
  "description": "A real, visible browser in VS Code for local AI agents and everyday web tasks.",
  "version": "0.1.8",
  "publisher": "SZLK",
  "icon": "icon.png",
  "license": "MIT",
  "private": false,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "agent",
    "browser",
    "mcp",
    "automation",
    "vscode",
    "webview",
    "screencast",
    "mjpeg",
    "playwright",
    "puppeteer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/bmcp.git"
  },
  "homepage": "https://github.com/jobssteve164dev/bmcp#readme",
  "bugs": {
    "url": "https://github.com/jobssteve164dev/bmcp/issues"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCommand:bmcp.openBrowser",
    "onCommand:bmcp.runDemo"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bmcp.openBrowser",
        "title": "SoloBrowser: Open Browser"
      },
      {
        "command": "bmcp.runDemo",
        "title": "SoloBrowser: Run Demo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bmcp-explorer",
          "title": "SoloBrowser",
          "icon": "$(globe)"
        }
      ]
    },
    "views": {
      "bmcp-explorer": [
        {
          "type": "webview",
          "id": "bmcp.browserView",
          "name": "SoloBrowser"
        }
      ]
    },
    "configuration": {
      "title": "SoloBrowser",
      "properties": {
        "bmcp.port": {
          "type": "number",
          "default": 17333,
          "description": "Local HTTP port used by local AI agents to control SoloBrowser."
        },
        "bmcp.browserPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a stable Chrome, Edge, or Chromium installation used by SoloBrowser."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/browserRuntime.js && node --check src/pageModel.js && node --check scripts/smoke-http.js",
    "test": "node test/pageModel.test.js && node test/sidebarView.test.js && node test/browserRuntime.test.js",
    "package": "vsce package --allow-star-activation",
    "publish:marketplace": "vsce publish --allow-star-activation -p $VSCE_PAT",
    "smoke:http": "node scripts/smoke-http.js",
    "verify": "npm run check && npm test && npm run package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ws": "^8.21.0"
  }
}
